# ============================================
# SMTP 邮件服务配置说明
# ============================================

# 是否启用邮件发送功能
# 开发环境建议设为 False（使用模拟发送）
# 生产环境设为 True（实际发送邮件）
EMAILS_ENABLED=False

# SMTP 服务器配置
# 常用邮箱服务商的 SMTP 设置：
# 
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS=True
#   需要使用应用专用密码（不是账户密码）
#   https://support.google.com/accounts/answer/185833
#
# QQ邮箱:
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=587 或 465
#   SMTP_TLS=True (587端口) 或 SMTP_SSL=True (465端口)
#   需要开启 SMTP 服务并获取授权码
#
# 163邮箱:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_SSL=True
#   需要开启 SMTP 服务并获取授权码
#
# Outlook/Hotmail:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_TLS=True

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False

# SMTP 认证信息
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 发件人信息
EMAILS_FROM_EMAIL=noreply@cautod.com
EMAILS_FROM_NAME=CAutoD Platform

# 前端地址（用于邮件中的链接）
FRONTEND_HOST=http://localhost:5173

# Token 有效期（小时）
EMAIL_RESET_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# 项目名称
PROJECT_NAME=CAutoD

# ============================================
# 配置步骤
# ============================================
#
# 1. 复制此文件内容到你的 .env.dev 或 .env.prod 文件
# 2. 根据你使用的邮箱服务商填写 SMTP 配置
# 3. 填写正确的 SMTP_USER 和 SMTP_PASSWORD
# 4. 设置 EMAILS_ENABLED=True 启用邮件发送
# 5. 安装依赖: pip install emails
# 6. 重启应用
#
# ============================================
# 测试邮件发送
# ============================================
#
# 启动应用后访问 Swagger 文档：
# http://localhost:8080/docs
#
# 找到 /api/auth/password-recovery 接口
# 输入一个已注册的邮箱地址进行测试
#
# 如果配置正确，应该能收到密码重置邮件
#
