# CAutoD FastAPI - 环境变量模板（不要填真实密钥进仓库）
#
# 说明：
# - 当前仓库中的 `.env.dev/.env.prod` 在本环境下被过滤（globalignore），不便作为示例展示
# - 因此提供一个可复制的模板文件 `docs/ENV_EXAMPLE.env`
# - 使用时请复制到安全位置并按部署方式注入环境变量
#
# 注意：
# - 下面所有 *_SECRET / *_PASSWORD / *_KEY 都是敏感信息，只能放在部署环境的 secret 管理中

PROJECT_NAME=CAutoD
FRONTEND_HOST=http://localhost:5173
DEBUG_MODE=false

# 文件与静态资源
DIRECTORY=files
STATIC_DIR=files
STATIC_URL=/files
STATIC_NAME=files

# JWT / Auth（敏感）
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_DAYS=7

# 数据库
SQLMODE=SQLITE
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cautod
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=cautod

# 邮件
EMAILS_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=
SMTP_TLS=false
SMTP_SSL=true
SMTP_PORT=465
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10

# OAuth（敏感）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=change_me
GITHUB_REDIRECT_URL=
GITHUB_TOKEN_URL=
GITHUB_USER_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_REDIRECT_URL=
GOOGLE_AUTHORIZATION_URL=
GOOGLE_TOKEN_URL=
GOOGLE_USER_INFO_URL=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_AVAILABLE=true

# 外部服务（敏感）
OPTIMIZE_API_URL=http://127.0.0.1:8000
DIFY_API_BASE_URL=
DIFY_API_KEY=change_me
DIFY_LISTEN_HOST=127.0.0.1
DIFY_LISTEN_PORT=5001
DIFY_TARGET_HOST=127.0.0.1
DIFY_TARGET_PORT=5001

# Dify Chat Embedding（敏感）
DIFY_CHAT_TOKEN=change_me
DIFY_CHAT_BASE_URL=


